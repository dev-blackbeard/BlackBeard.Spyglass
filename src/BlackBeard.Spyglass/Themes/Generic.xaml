<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:BlackBeard.Spyglass.Controls">

    <Style TargetType="{x:Type controls:TourOverlay}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:TourOverlay}">
                    <Grid x:Name="PART_Root" ClipToBounds="True">
                        <ContentPresenter x:Name="PART_Content" />

                        <Path
                            x:Name="PART_Scrim"
                            Fill="{TemplateBinding ScrimBrush}"
                            IsHitTestVisible="True"
                            Stretch="None" />

                        <ContentControl
                            x:Name="PART_Prompt"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Focusable="False"
                            Visibility="Collapsed">
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#22000000" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Padding" Value="20" />
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.Template>
                                <ControlTemplate TargetType="{x:Type ContentControl}">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="24"
                                                Direction="270"
                                                Opacity="0.35"
                                                ShadowDepth="4" />
                                        </Border.Effect>
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>

                        <ContentControl
                            x:Name="PART_Callout"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Focusable="False"
                            Visibility="Collapsed">
                            <ContentControl.Style>
                                <Style TargetType="{x:Type ContentControl}">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="BorderBrush" Value="#22000000" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Padding" Value="12" />
                                </Style>
                            </ContentControl.Style>
                            <ContentControl.Template>
                                <ControlTemplate TargetType="{x:Type ContentControl}">
                                    <Border
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="18"
                                                Direction="270"
                                                Opacity="0.3"
                                                ShadowDepth="3" />
                                        </Border.Effect>
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </ContentControl.Template>
                        </ContentControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
