<Window
    x:Class="Spyglass.Demo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:prism="http://prismlibrary.com/"
    xmlns:sg="http://schemas.blackbeard.dev/spyglass"
    Title="Spyglass Demo"
    Width="900"
    Height="600">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Help">
                <MenuItem Command="{Binding ReplayTourCommand}" Header="_Replay tour" />
            </MenuItem>
        </Menu>

        <sg:TourOverlay ScrimBrush="#CC101828" SpotlightCornerRadius="8" SpotlightPadding="10">
            <sg:TourOverlay.NextButtonStyle>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Background" Value="#2563EB" />
                    <Setter Property="Foreground" Value="Pink" />
                    <Setter Property="Padding" Value="14,6" />
                    <Setter Property="BorderThickness" Value="0" />
                </Style>
            </sg:TourOverlay.NextButtonStyle>

            <sg:TourOverlay.EndButtonStyle>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Padding" Value="14,6" />
                </Style>
            </sg:TourOverlay.EndButtonStyle>

            <sg:TourOverlay.CalloutStyle>
                <Style TargetType="{x:Type ContentControl}">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="BorderBrush" Value="#334155" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="White" />
                    <Setter Property="Padding" Value="16" />
                </Style>
            </sg:TourOverlay.CalloutStyle>

            <ContentControl prism:RegionManager.RegionName="MainRegion" />
        </sg:TourOverlay>
    </DockPanel>
</Window>
