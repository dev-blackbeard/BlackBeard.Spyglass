<UserControl
    x:Class="Spyglass.Demo.Views.NestedPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sg="http://schemas.blackbeard.dev/spyglass">
    <Border
        Padding="8"
        BorderBrush="#33000000"
        BorderThickness="1"
        CornerRadius="4">
        <StackPanel>
            <TextBlock
                Margin="0,0,0,4"
                FontSize="10"
                Opacity="0.6"
                Text="Nested panel" />
            <Border Padding="4">
                <Button
                    Padding="10,4"
                    sg:Spyglass.TargetId="nested-target"
                    Content="Nested target" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
